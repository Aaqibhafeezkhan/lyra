{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "esModuleInterop": true, "types": ["vite/client"],
    "paths": { "@shared/*": ["./src/shared/*"], "@core/*": ["./src/core/*"], "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/android-web/**/*", "src/core/**/*", "src/shared/**/*", "src/preload/*.d.ts"]
}
