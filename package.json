{
  "name": "lyra",
  "productName": "Lyra",
  "version": "0.2.4",
  "description": "Glassmorphism lyrics & playback companion for Spotify",
  "author": "Dhruv Harani",
  "license": "MIT",
  "homepage": "https://github.com/DhruvHarani1/lyra",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "icons": "electron scripts/icon-from-image.js",
    "dist:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist-local.ps1"
  },
  "build": {
    "appId": "dev.lyra.companion",
    "productName": "Lyra",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/lyra-media.exe",
        "to": "lyra-media.exe"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lyra",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lyra-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "allowElevation": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DhruvHarani1",
        "repo": "lyra",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
